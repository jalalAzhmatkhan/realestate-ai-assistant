# Copy to `.env` and fill in. Every variable below is read by app/core/config.py:Settings.
# Values shown are safe local-dev defaults; API keys are intentionally empty.
# Keep comments on their own lines: python-dotenv folds a trailing `# ...` into the
# value when the value itself is empty.

# --- Application ---
# APP_ENV: dev | prod — controls log format and /docs exposure
APP_ENV=dev
LOG_LEVEL=INFO

# --- Database ---
# DATABASE_URL: used as-is for non-Docker local dev (`uv run uvicorn`).
# docker-compose overrides this for the containerized backend by building a
# Postgres DSN from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below - swap
# to a real Postgres DSN here too if you want `uv run uvicorn` to talk to the
# same Postgres container.
DATABASE_URL=sqlite:///./app.db
# SEED_DATA_DIR is resolved relative to the process working directory (backend/)
SEED_DATA_DIR=./seed_data
SEED_ON_STARTUP=true

# --- Postgres (docker-compose only) ---
# Injected directly into the `postgres` container (see docker-compose.yml)
# and used to build DATABASE_URL for the `backend` container via Compose
# variable interpolation - change these three and both containers pick up
# the new credentials from one place. Not read by app/core/config.py.
# Compose only interpolates ${VARS} from a .env file in the project root by
# default, NOT from this file automatically - run compose with:
#   docker compose --env-file backend/.env up
POSTGRES_USER=realestate
POSTGRES_PASSWORD=realestate-dev-only
POSTGRES_DB=realestate

# --- Auth / session ---
# JWT_SECRET_KEY is REQUIRED. Generate for anything non-local: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=session
# SESSION_COOKIE_SECURE=false is only acceptable for local http://localhost dev
SESSION_COOKIE_SECURE=false

# --- Redis (token revocation denylist) ---
# REDIS_URL backs POST /auth/logout's JWT denylist (app/core/revocation.py) so a
# logged-out token stops working immediately instead of just expiring naturally.
# docker-compose overrides this to redis://redis:6379/0 for the containerized
# backend; this default targets a Redis reachable at localhost:6379 for non-Docker
# local dev. Not a hard dependency: the client connects lazily and revocation checks
# fail OPEN if Redis is unreachable (see revocation.py), so `uv run uvicorn` boots
# and serves auth traffic fine with no Redis running at all.
REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
# LLM_PROVIDER is REQUIRED: openai | anthropic | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---
# EMBEDDING_PROVIDER follows itself, never LLM_PROVIDER — Anthropic has no
# embeddings API, so RAG must keep working no matter which LLM_PROVIDER is
# selected. EMBEDDING_PROVIDER: openai | gemini | local (local needs no API
# key). Each provider has its own model var, same pattern as OPENAI_MODEL/
# ANTHROPIC_MODEL/GEMINI_MODEL above — only the one matching
# EMBEDDING_PROVIDER is actually used.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG ---
RAG_TOP_K=3
RAG_MIN_SCORE=0.55

# --- RAG observability ---
# Off means no rows are written, never zero scores: the admin page then shows an
# empty state rather than something that looks like a failing measurement.
RETRIEVAL_LOG_ENABLED=true
FAITHFULNESS_CHECK_ENABLED=true
FAITHFULNESS_MAX_CONCURRENT=4
FAITHFULNESS_MAX_CLAIMS=20
EVAL_SET_MAX_CASES=60

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- CORS ---
# Comma-separated explicit origins. `*` is rejected at startup: cookie-authenticated
# browser logins are credentialed requests, which browsers refuse against a wildcard
# origin. Add the admin SPA's origin here when frontend/admin exists.
CORS_ALLOWED_ORIGINS=http://localhost:5173
